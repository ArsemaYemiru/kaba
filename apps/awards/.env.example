DATABASE_URL=postgresql://feta:feta@localhost:5436/feta_awards
BETTER_AUTH_SECRET=change-me-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001
APP_TIMEZONE=Africa/Addis_Ababa
# development | staging | production (the real site). Production refuses test-only switches.
APP_ENV=development
VOTE_HASH_SECRET=change-me-at-least-32-chars

SEED_ADMIN_EMAIL=admin@fetaawards.com
# Quoted: an unquoted "#" starts a comment in .env files.
SEED_ADMIN_PASSWORD="Feta#Admin2026"
SEED_EDITOR_EMAIL=editor@fetaawards.com
SEED_EDITOR_PASSWORD="Feta#Editor2026"
# dev/staging demo members only
SEED_MEMBER_PASSWORD="Feta#Member2026"

# Mailpit in dev (docker-compose.awards.yml): SMTP 1026, inbox UI http://localhost:8026
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Feta Awards <no-reply@your-domain.com>"

# Cloudflare Turnstile test keys (always pass). Replace in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# 1 = skip Turnstile (e2e/k6 only; refused in production)
TURNSTILE_BYPASS=0
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# empty = Google sign-in off
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# console | custom (phone OTP)
SMS_PROVIDER=console
# 1 = members can add a phone number and verify it by SMS code (console driver in dev)
ENABLE_PHONE_OTP=1

# empty = Postgres rate limiter
REDIS_URL=

# local | r2
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=feta-media
R2_PUBLIC_URL=

UPLOAD_MAX_IMAGE_MB=10
UPLOAD_MAX_VIDEO_MB=1024

# plausible | umami | empty = off
ANALYTICS_PROVIDER=
ANALYTICS_SITE_ID=
# optional: self-hosted script URL (defaults to the provider cloud script)
ANALYTICS_SCRIPT_URL=
