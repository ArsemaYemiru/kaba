DATABASE_URL=postgresql://feta:feta@localhost:5436/feta_awards
BETTER_AUTH_SECRET=change-me-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001
APP_TIMEZONE=Africa/Addis_Ababa
# development | staging | production (the real site). Production refuses test-only switches.
APP_ENV=development

SEED_ADMIN_EMAIL=admin@fetaawards.com
# Quoted: an unquoted "#" starts a comment in .env files.
SEED_ADMIN_PASSWORD="Feta#Admin2026"
SEED_EDITOR_EMAIL=editor@fetaawards.com
SEED_EDITOR_PASSWORD="Feta#Editor2026"

# Optional: staff password-reset emails. Dev uses Mailpit (docker-compose.awards.yml): SMTP 1026, inbox UI http://localhost:8026
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Feta Awards <no-reply@your-domain.com>"

# empty = Postgres rate limiter
REDIS_URL=

# local | r2
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=feta-media
R2_PUBLIC_URL=

UPLOAD_MAX_IMAGE_MB=40
UPLOAD_MAX_VIDEO_MB=1024

# plausible | umami | empty = off
ANALYTICS_PROVIDER=
ANALYTICS_SITE_ID=
# optional: self-hosted script URL (defaults to the provider cloud script)
ANALYTICS_SCRIPT_URL=
