# Reference only. bootstrap.sh (new server) or switch-to-awards.sh (existing
# Feta Show server) creates /opt/kaba-prod/.env with random values.
POSTGRES_PASSWORD=replace-with-random-hex
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
PRODUCTION_URL=http://13.140.175.12:3006
WEB_BIND_IP=0.0.0.0
WEB_PORT=3006
STORAGE_DRIVER=local
SEED_ADMIN_EMAIL=admin@fetaawards.com
SEED_ADMIN_PASSWORD=replace-with-unique-password-at-least-12-characters
SEED_EDITOR_EMAIL=editor@fetaawards.com
SEED_EDITOR_PASSWORD=replace-with-unique-password-at-least-12-characters
# Optional: staff password-reset emails (any SMTP provider).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Feta Awards <no-reply@example.com>
# Optional R2 (also set the R2_PUBLIC_URL GitHub repository variable at build time):
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=
# Optional analytics (Plausible/Umami):
# ANALYTICS_PROVIDER=
# ANALYTICS_SITE_ID=
# ANALYTICS_SCRIPT_URL=
